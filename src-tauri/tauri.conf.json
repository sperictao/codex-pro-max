{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Codex Pro Max",
  "version": "1.17.0",
  "identifier": "com.codex.pro.max",
  "build": {
    "beforeDevCommand": "pnpm run ensure:taskboard && pnpm run dev",
    "beforeBuildCommand": "pnpm run build:taskboard && pnpm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173"
    },
    "windows": [
      {
        "label": "main",
        "title": "Codex Pro Max",
        "width": 960,
        "height": 680,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "decorations": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../vendor/dashi-taskboard/server": "vendor/dashi-taskboard/server",
      "../vendor/dashi-taskboard/shared": "vendor/dashi-taskboard/shared",
      "../vendor/dashi-taskboard/scripts": "vendor/dashi-taskboard/scripts",
      "../vendor/dashi-taskboard/cli": "vendor/dashi-taskboard/cli",
      "../vendor/dashi-taskboard/inject": "vendor/dashi-taskboard/inject",
      "../vendor/dashi-taskboard/skills": "vendor/dashi-taskboard/skills",
      "../vendor/dashi-taskboard/dist/web": "vendor/dashi-taskboard/dist/web",
      "../vendor/dashi-taskboard/package.json": "vendor/dashi-taskboard/package.json",
      "../vendor/dashi-taskboard/node_modules/smol-toml": "vendor/dashi-taskboard/node_modules/smol-toml",
      "../vendor/dashi-taskboard/node_modules/ws": "vendor/dashi-taskboard/node_modules/ws",
      "../vendor/dashi-taskboard/integrations/deepseek-harness": "vendor/dashi-taskboard/integrations/deepseek-harness"
    },
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "shell": {
      "open": "(https?://.+|/.+|[A-Za-z]:.+)"
    },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
